{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // chimera-context's built types import '@chimera/core', so compiling core
    // pulled its own dist/*.d.ts back in as inputs and tsc refused to overwrite
    // them (TS5055) on any rebuild over an existing dist. Resolve self-imports
    // to src so the cycle never reaches dist.
    "baseUrl": ".",
    "paths": {
      "@chimera/core": ["./src/index.ts"],
      "@chimera/core/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
