{
  "name": "@chimera/tools",
  "version": "0.5.7",
  "description": "Tool registry: filesystem, search, shell, git, patch engine, test runner, LSP, MCP",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hooks/trust": {
      "types": "./dist/hooks/trust.d.ts",
      "default": "./dist/hooks/trust.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chimera/core": "workspace:*",
    "@chimera/lsp": "workspace:*",
    "diff": "^7.0.0",
    "execa": "^9.0.0",
    "js-yaml": "^4.1.0",
    "pdf-parse": "^1.1.1",
    "typescript-language-server": "^5.3.0",
    "yaml": "^2.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/diff": "^6.0.0",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^22.0.0"
  }
}
