{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    // See chimera-core/tsconfig.json: resolve self-imports to src so a
    // dependency's built .d.ts can't pull this package's own dist/*.d.ts in as
    // compiler inputs (TS5055 on rebuild over an existing dist).
    "baseUrl": ".",
    "paths": {
      "@chimera/session": ["./src/index.ts"],
      "@chimera/session/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}